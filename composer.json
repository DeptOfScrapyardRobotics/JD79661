{
    "name": "dept-of-scrapyard-robotics/jd79661",
    "description": "Drive JD79661 four-colour (black/white/red/yellow) ePaper panels over SPI with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "jd79661",
        "epaper",
        "e-ink",
        "display",
        "spi",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.10.0",
        "gpio/integrated-circuits": "^0.10.0",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "require-dev": {
        "gpio/digital": "^0.10.0",
        "gpio/spi": "^0.10.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0"
    },
    "suggest": {
        "gpio/digital": "^0.10.0 - DC, RST and BUSY pins for JD79661SPITransport",
        "gpio/spi": "^0.10.0 - SPI connections for JD79661SPITransport",
        "microscrap/scrapyard-linux": "^0.10.0 - native spidev and libgpiod drivers",
        "microscrap/scrapyard-usb": "^0.10.0 - MPSSE SPI and pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\JD79661\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\JD79661\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Displays\\JD79661\\Providers\\JD79661ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
